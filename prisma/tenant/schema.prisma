generator client {
  provider = "prisma-client"
  output   = "../../generated/tenant-client"
}

datasource db {
  provider = "postgresql"
}

model TenantSchemaMigration {
  version   String   @id @db.VarChar(80)
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("tenant_schema_migrations")
}

model TenantMetadata {
  singleton     Boolean  @id @default(true)
  tenantId      String   @unique @map("tenant_id") @db.Uuid
  slug          String   @unique @db.VarChar(63)
  provisionedAt DateTime @default(now()) @map("provisioned_at") @db.Timestamptz(6)
  schemaVersion String   @map("schema_version") @db.VarChar(80)

  users       TenantUser[]
  sessions    TenantAuthSession[]
  roles       TenantRole[]
  permissions TenantPermission[]
  invitations TenantInvitation[]
  auditLogs   TenantAuditLog[]

  @@map("tenant_metadata")
}

model TenantRoleTemplate {
  code        String   @id @db.VarChar(40)
  name        String   @db.VarChar(120)
  // Kept only for the Phase 1 seed-table migration compatibility; Phase 2
  // grants are normalized in TenantPermission and TenantRolePermission.
  permissions Json     @default("[]") @db.JsonB
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("tenant_role_templates")
}

model TenantUser {
  id               String    @id @db.VarChar(64)
  tenantId         String    @map("tenantId") @db.Uuid
  name             String    @db.VarChar(120)
  email            String    @db.VarChar(320)
  emailVerified    Boolean   @default(false)
  image            String?   @db.Text
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @db.Timestamptz(6)
  status           String    @default("INVITED") @db.VarChar(20)
  mobile           String?   @db.VarChar(32)
  mobileVerifiedAt DateTime? @db.Timestamptz(6)
  lastLoginAt      DateTime? @db.Timestamptz(6)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime? @db.Timestamptz(6)

  tenant       TenantMetadata            @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)
  accounts     TenantAuthAccount[]
  sessions     TenantAuthSession[]
  roles        TenantUserRole[]
  staffProfile TenantStaffProfile?
  instructor   TenantInstructorProfile?
  participant  TenantParticipantProfile?
  invitations  TenantInvitation[]
  auditAsActor TenantAuditLog[]

  @@unique([tenantId, id], map: "tenant_users_tenant_id_id_key")
  @@unique([tenantId, email], map: "tenant_users_tenant_id_email_key")
  @@unique([tenantId, mobile], map: "tenant_users_tenant_id_mobile_key")
  @@index([tenantId, status], map: "tenant_users_tenant_id_status_idx")
  @@map("tenant_users")
}

model TenantAuthSession {
  id                  String   @id @default(dbgenerated("gen_random_uuid()::text")) @db.VarChar(64)
  expiresAt           DateTime @db.Timestamptz(6)
  token               String   @unique @db.VarChar(255)
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @db.Timestamptz(6)
  ipAddress           String?  @db.VarChar(45)
  userAgent           String?  @db.Text
  userId              String   @db.VarChar(64)
  tenantId            String   @db.Uuid
  authenticationLevel String   @default("PASSWORD") @db.VarChar(32)

  user   TenantUser     @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  tenant TenantMetadata @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@index([userId], map: "tenant_auth_sessions_userId_idx")
  @@index([tenantId, expiresAt], map: "tenant_auth_sessions_tenant_expires_idx")
  @@map("tenant_auth_sessions")
}

model TenantAuthAccount {
  id                    String    @id @db.VarChar(64)
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(100)
  userId                String    @db.VarChar(64)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @db.Timestamptz(6)

  user TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId], map: "tenant_auth_accounts_provider_account_key")
  @@index([userId], map: "tenant_auth_accounts_userId_idx")
  @@map("tenant_auth_accounts")
}

model TenantAuthVerification {
  id         String   @id @default(dbgenerated("gen_random_uuid()::text")) @db.VarChar(64)
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([identifier], map: "tenant_auth_verifications_identifier_idx")
  @@map("tenant_auth_verifications")
}

model TenantAuthRateLimit {
  id          String @id @default(dbgenerated("gen_random_uuid()::text")) @db.VarChar(64)
  key         String @unique @db.VarChar(255)
  count       Int
  lastRequest BigInt

  @@map("tenant_auth_rate_limits")
}

model TenantRole {
  id          String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   @db.VarChar(80)
  name        String   @db.VarChar(120)
  description String   @default("") @db.VarChar(500)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant      TenantMetadata         @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)
  users       TenantUserRole[]
  permissions TenantRolePermission[]

  @@id([tenantId, id])
  @@unique([tenantId, code], map: "tenant_roles_tenant_id_code_key")
  @@index([tenantId, isSystem], map: "tenant_roles_tenant_id_system_idx")
  @@map("tenant_roles")
}

model TenantPermission {
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String   @db.VarChar(64)
  module      String   @db.VarChar(32)
  name        String   @db.VarChar(120)
  description String   @default("") @db.VarChar(500)
  highRisk    Boolean  @default(false) @map("high_risk")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant TenantMetadata         @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)
  roles  TenantRolePermission[]

  @@id([tenantId, key])
  @@map("tenant_permissions")
}

model TenantUserRole {
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.VarChar(64)
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user TenantUser @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  role TenantRole @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, userId, roleId])
  @@index([tenantId, roleId], map: "tenant_user_roles_tenant_role_idx")
  @@map("tenant_user_roles")
}

model TenantRolePermission {
  tenantId      String   @map("tenant_id") @db.Uuid
  roleId        String   @map("role_id") @db.Uuid
  permissionKey String   @map("permission_key") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       TenantRole       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  permission TenantPermission @relation(fields: [tenantId, permissionKey], references: [tenantId, key], onDelete: Restrict)

  @@id([tenantId, roleId, permissionKey])
  @@index([tenantId, permissionKey], map: "tenant_role_permissions_tenant_permission_idx")
  @@map("tenant_role_permissions")
}

model TenantStaffProfile {
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.VarChar(64)
  title     String?  @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user TenantUser @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@map("tenant_staff_profiles")
}

model TenantInstructorProfile {
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String   @map("user_id") @db.VarChar(64)
  displayName String   @map("display_name") @db.VarChar(120)
  bio         String   @default("") @db.VarChar(2000)
  specialties String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user TenantUser @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@map("tenant_instructor_profiles")
}

model TenantParticipantProfile {
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String   @map("user_id") @db.VarChar(64)
  displayName String   @map("display_name") @db.VarChar(120)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user TenantUser @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@map("tenant_participant_profiles")
}

model TenantInvitation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.VarChar(64)
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  invitedBy  String?   @map("invited_by") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant TenantMetadata @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)
  user   TenantUser     @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, userId, expiresAt], map: "tenant_invitations_user_expiry_idx")
  @@map("tenant_invitations")
}

model TenantAuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.VarChar(64)
  action      String   @db.VarChar(120)
  targetType  String   @map("target_type") @db.VarChar(64)
  targetId    String?  @map("target_id") @db.VarChar(128)
  requestId   String   @map("request_id") @db.VarChar(36)
  beforeState Json?    @map("before_state") @db.JsonB
  afterState  Json?    @map("after_state") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant TenantMetadata @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)
  actor  TenantUser?    @relation(fields: [tenantId, actorId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, targetType, targetId, createdAt(sort: Desc)], map: "tenant_audit_target_recent_idx")
  @@index([tenantId, actorId, createdAt(sort: Desc)], map: "tenant_audit_actor_recent_idx")
  @@map("tenant_audit_logs")
}
