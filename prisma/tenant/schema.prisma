generator client {
  provider = "prisma-client"
  output   = "../../generated/tenant-client"
}

datasource db {
  provider = "postgresql"
}

model TenantSchemaMigration {
  version   String   @id @db.VarChar(80)
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("tenant_schema_migrations")
}

model TenantMetadata {
  singleton     Boolean  @id @default(true)
  tenantId      String   @unique @map("tenant_id") @db.Uuid
  slug          String   @unique @db.VarChar(63)
  provisionedAt DateTime @default(now()) @map("provisioned_at") @db.Timestamptz(6)
  schemaVersion String   @map("schema_version") @db.VarChar(80)

  users       TenantUser[]
  sessions    TenantAuthSession[]
  roles       TenantRole[]
  permissions TenantPermission[]
  invitations TenantInvitation[]
  auditLogs   TenantAuditLog[]
  website     TenantWebsiteProfile?
  media       TenantMedia[]

  @@map("tenant_metadata")
}

model TenantWebsiteProfile {
  tenantId          String   @id @map("tenant_id") @db.Uuid
  displayName       String   @default("") @map("display_name") @db.VarChar(160)
  shortDescription  String   @default("") @map("short_description") @db.VarChar(500)
  about             String   @default("") @db.Text
  logoUrl           String   @default("") @map("logo_url") @db.VarChar(2048)
  coverUrl          String   @default("") @map("cover_url") @db.VarChar(2048)
  faviconUrl        String   @default("") @map("favicon_url") @db.VarChar(2048)
  phone             String   @default("") @db.VarChar(40)
  email             String   @default("") @db.VarChar(320)
  address           String   @default("") @db.VarChar(500)
  websiteUrl        String   @default("") @map("website_url") @db.VarChar(2048)
  socialUrl         String   @default("") @map("social_url") @db.VarChar(2048)
  contactHours      String   @default("") @map("contact_hours") @db.VarChar(200)
  footerDescription String   @default("") @map("footer_description") @db.VarChar(500)
  primaryColor      String   @default("#0e766e") @map("primary_color") @db.VarChar(7)
  secondaryColor    String   @default("#174b48") @map("secondary_color") @db.VarChar(7)
  accentColor       String   @default("#d39b45") @map("accent_color") @db.VarChar(7)
  heroEnabled       Boolean  @default(true) @map("hero_enabled")
  featuredEnabled   Boolean  @default(true) @map("featured_enabled")
  aboutEnabled      Boolean  @default(true) @map("about_enabled")
  contactEnabled    Boolean  @default(true) @map("contact_enabled")
  cardStyle         String   @default("SOFT") @map("card_style") @db.VarChar(16)
  radiusStyle       String   @default("MEDIUM") @map("radius_style") @db.VarChar(16)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  siteSettings      Json     @default("{}") @map("site_settings") @db.JsonB

  tenant TenantMetadata @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)

  @@map("tenant_website_profiles")
}

model TenantMedia {
  tenantId    String   @map("tenant_id") @db.Uuid
  id          String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purpose     String   @db.VarChar(32)
  resourceId  String   @map("resource_id") @db.Uuid
  objectKey   String   @unique @map("object_key") @db.VarChar(300)
  contentType String   @map("content_type") @db.VarChar(32)
  sizeBytes   BigInt   @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant TenantMetadata @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)

  @@id([tenantId, id])
  @@unique([tenantId, purpose, resourceId])
  @@index([tenantId, purpose], map: "tenant_media_usage_idx")
  @@map("tenant_media")
}

model TenantRoleTemplate {
  code        String   @id @db.VarChar(40)
  name        String   @db.VarChar(120)
  // Kept only for the Phase 1 seed-table migration compatibility; Phase 2
  // grants are normalized in TenantPermission and TenantRolePermission.
  permissions Json     @default("[]") @db.JsonB
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("tenant_role_templates")
}

model TenantUser {
  id               String    @id @default(dbgenerated("gen_random_uuid()::text")) @db.VarChar(64)
  tenantId         String    @map("tenantId") @db.Uuid
  name             String    @db.VarChar(120)
  email            String    @db.VarChar(320)
  emailVerified    Boolean   @default(false)
  image            String?   @db.Text
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @db.Timestamptz(6)
  status           String    @default("INVITED") @db.VarChar(20)
  mobile           String?   @db.VarChar(32)
  mobileVerifiedAt DateTime? @db.Timestamptz(6)
  lastLoginAt      DateTime? @db.Timestamptz(6)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime? @db.Timestamptz(6)

  tenant       TenantMetadata            @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)
  accounts     TenantAuthAccount[]
  sessions     TenantAuthSession[]
  roles        TenantUserRole[]
  staffProfile TenantStaffProfile?
  instructor   TenantInstructorProfile?
  participant  TenantParticipantProfile?
  invitations  TenantInvitation[]
  auditAsActor TenantAuditLog[]

  @@unique([tenantId, id], map: "tenant_users_tenant_id_id_key")
  @@unique([tenantId, email], map: "tenant_users_tenant_id_email_key")
  @@unique([tenantId, mobile], map: "tenant_users_tenant_id_mobile_key")
  @@index([tenantId, status], map: "tenant_users_tenant_id_status_idx")
  @@map("tenant_users")
}

model TenantAuthSession {
  id                  String   @id @default(dbgenerated("gen_random_uuid()::text")) @db.VarChar(64)
  expiresAt           DateTime @db.Timestamptz(6)
  token               String   @unique @db.VarChar(255)
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @db.Timestamptz(6)
  ipAddress           String?  @db.VarChar(45)
  userAgent           String?  @db.Text
  userId              String   @db.VarChar(64)
  tenantId            String   @db.Uuid
  authenticationLevel String   @default("PASSWORD") @db.VarChar(32)

  user   TenantUser     @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  tenant TenantMetadata @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@index([userId], map: "tenant_auth_sessions_userId_idx")
  @@index([tenantId, expiresAt], map: "tenant_auth_sessions_tenant_expires_idx")
  @@map("tenant_auth_sessions")
}

model TenantAuthAccount {
  id                    String    @id @default(dbgenerated("gen_random_uuid()::text")) @db.VarChar(64)
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(100)
  userId                String    @db.VarChar(64)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @db.Timestamptz(6)

  user TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId], map: "tenant_auth_accounts_provider_account_key")
  @@index([userId], map: "tenant_auth_accounts_userId_idx")
  @@map("tenant_auth_accounts")
}

model TenantAuthVerification {
  id         String   @id @default(dbgenerated("gen_random_uuid()::text")) @db.VarChar(64)
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([identifier], map: "tenant_auth_verifications_identifier_idx")
  @@map("tenant_auth_verifications")
}

model TenantAuthRateLimit {
  id          String @id @default(dbgenerated("gen_random_uuid()::text")) @db.VarChar(64)
  key         String @unique @db.VarChar(255)
  count       Int
  lastRequest BigInt

  @@map("tenant_auth_rate_limits")
}

model TenantRole {
  id          String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   @db.VarChar(80)
  name        String   @db.VarChar(120)
  description String   @default("") @db.VarChar(500)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant      TenantMetadata         @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)
  users       TenantUserRole[]
  permissions TenantRolePermission[]

  @@id([tenantId, id])
  @@unique([tenantId, code], map: "tenant_roles_tenant_id_code_key")
  @@index([tenantId, isSystem], map: "tenant_roles_tenant_id_system_idx")
  @@map("tenant_roles")
}

model TenantPermission {
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String   @db.VarChar(64)
  module      String   @db.VarChar(32)
  name        String   @db.VarChar(120)
  description String   @default("") @db.VarChar(500)
  highRisk    Boolean  @default(false) @map("high_risk")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant TenantMetadata         @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)
  roles  TenantRolePermission[]

  @@id([tenantId, key])
  @@map("tenant_permissions")
}

model TenantUserRole {
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.VarChar(64)
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user TenantUser @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  role TenantRole @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, userId, roleId])
  @@index([tenantId, roleId], map: "tenant_user_roles_tenant_role_idx")
  @@map("tenant_user_roles")
}

model TenantRolePermission {
  tenantId      String   @map("tenant_id") @db.Uuid
  roleId        String   @map("role_id") @db.Uuid
  permissionKey String   @map("permission_key") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       TenantRole       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  permission TenantPermission @relation(fields: [tenantId, permissionKey], references: [tenantId, key], onDelete: Restrict)

  @@id([tenantId, roleId, permissionKey])
  @@index([tenantId, permissionKey], map: "tenant_role_permissions_tenant_permission_idx")
  @@map("tenant_role_permissions")
}

model TenantStaffProfile {
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.VarChar(64)
  title     String?  @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user TenantUser @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@map("tenant_staff_profiles")
}

model TenantInstructorProfile {
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String   @map("user_id") @db.VarChar(64)
  displayName String   @map("display_name") @db.VarChar(120)
  bio         String   @default("") @db.VarChar(2000)
  specialties String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user TenantUser @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@map("tenant_instructor_profiles")
}

model TenantParticipantProfile {
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String   @map("user_id") @db.VarChar(64)
  displayName String   @map("display_name") @db.VarChar(120)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user TenantUser @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@map("tenant_participant_profiles")
}

model TenantInvitation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.VarChar(64)
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  invitedBy  String?   @map("invited_by") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant TenantMetadata @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)
  user   TenantUser     @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, userId, expiresAt], map: "tenant_invitations_user_expiry_idx")
  @@map("tenant_invitations")
}

model TenantAuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.VarChar(64)
  action      String   @db.VarChar(120)
  targetType  String   @map("target_type") @db.VarChar(64)
  targetId    String?  @map("target_id") @db.VarChar(128)
  requestId   String   @map("request_id") @db.VarChar(36)
  beforeState Json?    @map("before_state") @db.JsonB
  afterState  Json?    @map("after_state") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant TenantMetadata @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)
  actor  TenantUser?    @relation(fields: [tenantId, actorId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, targetType, targetId, createdAt(sort: Desc)], map: "tenant_audit_target_recent_idx")
  @@index([tenantId, actorId, createdAt(sort: Desc)], map: "tenant_audit_actor_recent_idx")
  @@map("tenant_audit_logs")
}

model Venue {
  tenantId    String   @map("tenant_id") @db.Uuid
  id          String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(160)
  address     String   @default("") @db.VarChar(500)
  city        String   @default("") @db.VarChar(120)
  description String   @default("") @db.VarChar(1000)
  active      Boolean  @default(true)
  createdBy   String?  @map("created_by") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, id])
  @@map("venues")
}

model Room {
  tenantId    String   @map("tenant_id") @db.Uuid
  id          String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId     String   @map("venue_id") @db.Uuid
  name        String   @db.VarChar(160)
  capacity    Int
  description String   @default("") @db.VarChar(1000)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, id])
  @@unique([tenantId, venueId, name])
  @@index([tenantId, venueId], map: "rooms_venue_idx")
  @@map("rooms")
}

model Program {
  tenantId               String    @map("tenant_id") @db.Uuid
  id                     String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                   String    @db.VarChar(24)
  title                  String    @db.VarChar(200)
  slug                   String    @db.VarChar(100)
  shortDescription       String    @default("") @map("short_description") @db.VarChar(500)
  description            String    @default("") @db.Text
  category               String    @default("") @db.VarChar(120)
  level                  String    @default("") @db.VarChar(80)
  objectives             String    @default("") @db.Text
  prerequisites          String    @default("") @db.Text
  intendedAudience       String    @default("") @map("intended_audience") @db.Text
  defaultDurationMinutes Int?      @map("default_duration_minutes")
  coverMetadata          Json      @default("{}") @map("cover_metadata") @db.JsonB
  status                 String    @default("DRAFT") @db.VarChar(16)
  createdBy              String    @map("created_by") @db.VarChar(64)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, id])
  @@unique([tenantId, slug])
  @@index([tenantId, status, createdAt(sort: Desc)], map: "programs_status_idx")
  @@map("programs")
}

model ProgramRun {
  tenantId             String    @map("tenant_id") @db.Uuid
  id                   String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId            String    @map("program_id") @db.Uuid
  title                String    @db.VarChar(200)
  startsAt             DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt               DateTime  @map("ends_at") @db.Timestamptz(6)
  registrationStartsAt DateTime? @map("registration_starts_at") @db.Timestamptz(6)
  registrationEndsAt   DateTime? @map("registration_ends_at") @db.Timestamptz(6)
  deliveryMode         String    @map("delivery_mode") @db.VarChar(16)
  capacity             Int
  priceAmount          BigInt    @default(0) @map("price_amount")
  priceCurrency        String    @default("IRR") @map("price_currency") @db.VarChar(3)
  minimumCapacity      Int?      @map("minimum_capacity")
  waitlistEnabled      Boolean   @default(false) @map("waitlist_enabled")
  state                String    @default("DRAFT") @db.VarChar(16)
  venueId              String?   @map("venue_id") @db.Uuid
  notes                String    @default("") @db.Text
  registrationFormSchema Json     @default("{\"version\":1,\"fields\":[]}") @map("registration_form_schema") @db.JsonB
  createdBy            String    @map("created_by") @db.VarChar(64)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, id])
  @@index([tenantId, programId, startsAt(sort: Desc)], map: "program_runs_program_idx")
  @@index([tenantId, state, startsAt], map: "program_runs_state_idx")
  @@map("program_runs")
}

model Enrollment {
  tenantId           String   @map("tenant_id") @db.Uuid
  id                 String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId              String   @map("run_id") @db.Uuid
  participantId      String   @map("participant_id") @db.VarChar(64)
  status             String   @db.VarChar(16)
  paymentExpiresAt   DateTime? @map("payment_expires_at") @db.Timestamptz(6)
  answers            Json     @default("{}") @db.JsonB
  formSchemaSnapshot Json     @map("form_schema_snapshot") @db.JsonB
  registeredAt       DateTime @default(now()) @map("registered_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, id])
  @@unique([tenantId, runId, participantId])
  @@index([tenantId, runId, status, registeredAt], map: "enrollments_run_status_idx")
  @@index([tenantId, participantId, registeredAt(sort: Desc)], map: "enrollments_participant_idx")
  @@map("enrollments")
}

model PaymentProviderConfig {
  tenantId        String   @map("tenant_id") @db.Uuid
  providerKey     String   @map("provider_key") @db.VarChar(40)
  enabled         Boolean  @default(false)
  encryptedConfig Bytes    @map("encrypted_config")
  updatedBy       String   @map("updated_by") @db.VarChar(64)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, providerKey])
  @@map("payment_provider_configs")
}

model Coupon {
  tenantId      String    @map("tenant_id") @db.Uuid
  id            String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String    @db.VarChar(64)
  discountType  String    @map("discount_type") @db.VarChar(12)
  discountValue BigInt    @map("discount_value")
  currency      String    @db.VarChar(3)
  maxUses       Int?      @map("max_uses")
  usedCount     Int       @default(0) @map("used_count")
  startsAt      DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime? @map("ends_at") @db.Timestamptz(6)
  enabled       Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([tenantId, id])
  @@unique([tenantId, code])
  @@map("coupons")
}

model CouponReservation {
  tenantId       String   @map("tenant_id") @db.Uuid
  paymentId      String   @map("payment_id") @db.Uuid
  couponId       String   @map("coupon_id") @db.Uuid
  discountAmount BigInt   @map("discount_amount")
  status         String   @default("ACTIVE") @db.VarChar(12)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, paymentId])
  @@map("coupon_reservations")
}

model Payment {
  tenantId       String    @map("tenant_id") @db.Uuid
  id             String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enrollmentId   String    @map("enrollment_id") @db.Uuid
  participantId  String    @map("participant_id") @db.VarChar(64)
  originalAmount BigInt    @map("original_amount")
  discountAmount BigInt    @default(0) @map("discount_amount")
  payableAmount  BigInt    @map("payable_amount")
  paidAmount     BigInt    @default(0) @map("paid_amount")
  currency       String    @db.VarChar(3)
  couponId       String?   @map("coupon_id") @db.Uuid
  state          String    @default("CREATED") @db.VarChar(20)
  idempotencyKey String    @map("idempotency_key") @db.VarChar(128)
