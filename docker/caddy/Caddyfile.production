{
    email {$ACME_EMAIL}
}

{$PUBLIC_HOSTS} {
    encode zstd gzip
    request_body {
        max_size 52MB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
    reverse_proxy app:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }
}
