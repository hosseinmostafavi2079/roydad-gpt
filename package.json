{
  "name": "eventos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node .next/standalone/server.js",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:e2e": "pnpm build && pnpm test:e2e:run",
    "test:e2e:run": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "db:migrate": "node --conditions=react-server --import=tsx scripts/db-migrate.ts",
    "db:migrate:tenants": "node --conditions=react-server --import=tsx scripts/migrate-tenant-databases.ts",
    "db:seed:dev": "node --conditions=react-server --import=tsx scripts/bootstrap-dev-admin.ts",
    "demo:setup": "node --conditions=react-server --import=tsx scripts/demo-setup.ts",
    "demo:reset": "node --conditions=react-server --import=tsx scripts/demo-reset.ts",
    "local:setup": "node scripts/local-setup.mjs",
    "local:env": "node scripts/local-setup.mjs --env-only",
    "local:media:sync": "node --conditions=react-server --import=tsx scripts/sync-development-media.ts",
    "test:media:development": "playwright test --config playwright.development.config.ts",
    "local:media:reconcile": "node --conditions=react-server --import=tsx scripts/reconcile-development-media.ts",
    "local:build": "docker compose build app worker",
    "local:up": "docker compose --profile application up -d --no-build",
    "local:down": "docker compose down",
    "local:logs": "docker compose logs -f app worker postgres",
    "deploy:preflight": "node scripts/deploy-preflight.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "worker:provisioning": "node --conditions=react-server --import=tsx scripts/provisioning-worker.ts",
    "worker:payments": "node --conditions=react-server --import=tsx scripts/payment-maintenance-worker.ts",
    "worker:payments:once": "node --conditions=react-server --import=tsx scripts/payment-maintenance-once.ts",
    "auth:schema": "node --env-file=.env node_modules/auth/dist/index.mjs generate --config scripts/auth-config.ts --output src/infrastructure/db/control/migrations/0000_platform_auth.sql --yes",
    "audit:deps": "pnpm audit --prod --audit-level high",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1012.0",
    "@fontsource/vazirmatn": "5.3.0",
    "@next/env": "16.3.8",
    "@node-rs/argon2": "2.2.1",
    "better-auth": "1.7.6",
    "lucide-react": "1.48.0",
    "next": "16.3.8",
    "nodemailer": "10.0.11",
    "pdfkit": "0.19.1",
    "pg": "8.23.0",
    "pg-boss": "12.35.0",
    "pino": "10.3.1",
    "prisma": "7.10.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.6",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "packageManager": "pnpm@11.25.0"
}
