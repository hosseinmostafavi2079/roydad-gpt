# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.pnpm-store/
.phase2-prechange-e2e.log
.demo-credentials.local
/.local/
