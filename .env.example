# Copy this file to .env for local development and replace each placeholder.
# Never commit .env or reuse these development placeholders in production.
NODE_ENV=development
POSTGRES_HOST_PORT=55432

# Local Docker-only bootstrap credentials. Change them before starting Docker.
POSTGRES_SUPERUSER_PASSWORD=replace-with-local-only-value
CONTROL_APP_PASSWORD=replace-with-local-only-value
CONTROL_MIGRATION_PASSWORD=replace-with-local-only-value
CONTROL_QUEUE_PASSWORD=replace-with-local-only-value
TENANT_PROVISIONER_PASSWORD=replace-with-local-only-value
TENANT_RUNTIME_PASSWORD=replace-with-local-only-value
TENANT_MIGRATION_PASSWORD=replace-with-local-only-value

# Server-only connection strings. Runtime and elevated connections are distinct.
CONTROL_DATABASE_URL=postgresql://eventos_control_app:replace-with-local-only-value@127.0.0.1:55432/eventos_control
CONTROL_MIGRATION_DATABASE_URL=postgresql://eventos_control_migrator:replace-with-local-only-value@127.0.0.1:55432/eventos_control
CONTROL_QUEUE_DATABASE_URL=postgresql://eventos_control_queue:replace-with-local-only-value@127.0.0.1:55432/eventos_control
TENANT_PROVISIONING_DATABASE_URL=postgresql://eventos_tenant_provisioner:replace-with-local-only-value@127.0.0.1:55432/postgres
TENANT_RUNTIME_DATABASE_URL=postgresql://eventos_tenant_runtime:replace-with-local-only-value@127.0.0.1:55432/postgres
TENANT_MIGRATION_DATABASE_URL=postgresql://eventos_tenant_migrator:replace-with-local-only-value@127.0.0.1:55432/postgres

# Authentication and security. Generate a unique random value of at least 32 bytes.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-unique-random-secret-at-least-32-bytes
TENANT_BOOTSTRAP_ENCRYPTION_KEY=replace-with-a-dedicated-random-secret-at-least-32-characters
PLATFORM_BASE_DOMAIN=localhost
PLATFORM_REQUIRE_MFA=true
TRUSTED_PROXY_CIDRS=

# Password reset delivery is required in production; keep credentials in a secret store.
SMTP_URL=
SMTP_FROM=EventOS Security <security@example.invalid>
# Use "test" only in test processes with a private temporary outbox.
MAIL_TRANSPORT=smtp

# Bootstrap creates exactly one synthetic administrator and is development-only.
PLATFORM_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
PLATFORM_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-local-password

# Bounded per-tenant pool budget.
TENANT_POOL_LIMIT=16
TENANT_POOL_CONNECTIONS_PER_DATABASE=2
TENANT_POOL_IDLE_TIMEOUT_MS=30000
TENANT_POOL_ACQUIRE_TIMEOUT_MS=5000
LOG_LEVEL=info
