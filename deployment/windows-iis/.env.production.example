# Private operator file: copy to .env.production; restrict Windows ACL and WSL permissions.
# APP / DOMAIN (tenant host allow-list and TLS bindings belong to the dedicated IIS site)
NODE_ENV=production
EVENTOS_IMAGE=replace-with-registry/eventos@sha256:replace-with-64-hex-digest
BETTER_AUTH_URL=https://event.mediasanat.ir
PLATFORM_BASE_DOMAIN=mediasanat.ir
PLATFORM_REQUIRE_MFA=false
TRUSTED_PROXY_CIDRS=
LOG_LEVEL=info

# DATABASE (all URLs use the private Compose hostname postgres)
POSTGRES_SUPERUSER_PASSWORD=replace-with-unique-random-secret
CONTROL_APP_PASSWORD=replace-with-unique-random-secret
CONTROL_MIGRATION_PASSWORD=replace-with-unique-random-secret
CONTROL_QUEUE_PASSWORD=replace-with-unique-random-secret
TENANT_PROVISIONER_PASSWORD=replace-with-unique-random-secret
TENANT_RUNTIME_PASSWORD=replace-with-unique-random-secret
TENANT_MIGRATION_PASSWORD=replace-with-unique-random-secret
CONTROL_DATABASE_URL=postgresql://eventos_control_app:replace-with-password@postgres:5432/eventos_control
CONTROL_MIGRATION_DATABASE_URL=postgresql://eventos_control_migrator:replace-with-password@postgres:5432/eventos_control
CONTROL_QUEUE_DATABASE_URL=postgresql://eventos_control_queue:replace-with-password@postgres:5432/eventos_control
TENANT_PROVISIONING_DATABASE_URL=postgresql://eventos_tenant_provisioner:replace-with-password@postgres:5432/postgres
TENANT_RUNTIME_DATABASE_URL=postgresql://eventos_tenant_runtime:replace-with-password@postgres:5432/postgres
TENANT_MIGRATION_DATABASE_URL=postgresql://eventos_tenant_migrator:replace-with-password@postgres:5432/postgres

# AUTH / ENCRYPTION (generate independently with: openssl rand -hex 48)
BETTER_AUTH_SECRET=replace-with-unique-random-secret
TENANT_BOOTSTRAP_ENCRYPTION_KEY=replace-with-unique-random-secret

# GOOGLE OAUTH (leave all three empty to disable; exact tenant HTTPS origins only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_ORIGINS=

# EMAIL (real TLS SMTP is required for account and invitation delivery)
MAIL_TRANSPORT=smtp
SMS_TRANSPORT=provider
SMTP_URL=
SMTP_FROM=

# OBJECT STORAGE (external managed S3-compatible service; HTTPS only)
MEDIA_S3_ENDPOINT=https://storage.example.com
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=eventos-media
MEDIA_S3_ACCESS_KEY_ID=replace-with-access-key
MEDIA_S3_SECRET_ACCESS_KEY=replace-with-secret-key
MEDIA_S3_ALLOW_HTTP_LOCAL=false

# PAYMENT (no real adapter is installed; keep tenant payment features disabled)
# Do not configure or enable the TEST payment provider in production.
